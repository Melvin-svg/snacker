// YouPI-PG Gateway (Self-hosted UPI Gateway)
# For local Raspberry Pi dev: http://localhost:5000
# For remote/domain hosting: https://pay.yourdomain.com
YOUPI_GATEWAY_URL=http://localhost:5000
YOUPI_MERCHANT_ID=snacker-merchant-01
YOUPI_WEBHOOK_SECRET=your_long_random_webhook_secret

// Clerk Credentials
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

// Clerk API Routes
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/api/auth/create-user
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/api/auth/create-user

// Firebase Credentials
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=your_firebase_database_url
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key


// Optional YouPI UPI Gateway URL for local development (if you want to test UPI payments locally)
NEXT_PUBLIC_YOUPI_GATEWAY_URL=http://localhost:7000

// Admin account email (server-only, never NEXT_PUBLIC_)
ADMIN_EMAIL=admin@example.com
